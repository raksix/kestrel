{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kestrel",
  "mainBinaryName": "kestrel-app",
  "version": "0.1.1",
  "identifier": "com.raksix.kestrel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kestrel",
        "width": 1080,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**",
          "$TEMP/**",
          "$PICTURE/**",
          "$HOME/Pictures/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Capture, annotate and share",
    "longDescription": "Kestrel is a cross-platform capture, annotation and sharing tool in the spirit of ShareX.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "sxcu"
        ],
        "name": "ShareX Custom Uploader",
        "description": "ShareX custom uploader definition",
        "role": "Editor",
        "mimeType": "application/json"
      },
      {
        "ext": [
          "sxie"
        ],
        "name": "ShareX Image Effects",
        "description": "ShareX image effect preset",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "kestrel"
        ]
      }
    }
  }
}
